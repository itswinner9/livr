# Required for a live database-backed app
# Netlify: set these on Production, then Trigger deploy.
# Saving env vars does not update a live site until a new build.
# URL and keys must be from the SAME project (local .env.local).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server aliases (read at runtime; useful on Netlify)
SUPABASE_URL=
SUPABASE_ANON_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: set this to https://livrank.ca on Netlify. If it stays localhost,
# Google will send people back to http://localhost:3000/auth/callback.
# Also add both callback URLs under Supabase Authentication > URL Configuration:
# http://localhost:3000/auth/callback
# https://livrank.ca/auth/callback

# Optional Google Search Console HTML-tag verification token (verification meta, not a public key).
GOOGLE_SITE_VERIFICATION=

# Google sign-in is configured in the Supabase dashboard (Auth > Providers > Google),
# not with env vars here. Create a Google Cloud OAuth Web client, set the
# Authorized redirect URI to your project's https://<project-ref>.supabase.co/auth/v1/callback,
# then paste the Client ID and Secret into Supabase.

# Optional AI (OpenRouter). App works without these.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_FAST_MODEL=openai/gpt-4o-mini
OPENROUTER_REASONING_MODEL=openai/gpt-4o
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional Stripe (test mode). App works without these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PREMIUM_RENTER_PRICE_ID=
STRIPE_MANAGER_PRO_PRICE_ID=

# Optional email. App works without this.
RESEND_API_KEY=
RESEND_FROM_EMAIL=LivRank <noreply@example.com>

# Mapbox public token (pk.*): address autocomplete (Search Box API, server-side) and map tiles.
# Optional: without it, search covers LivRank properties only and maps use free CARTO tiles.
# Restrict the token to your domains in the Mapbox dashboard.
MAPBOX_ACCESS_TOKEN=
